# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO THE ARCHIVES
# Copy file này thành .env.local và điền thông tin thực tế
# ==========================================================

# 1. SUPABASE (Lấy tại Project Settings -> API trên supabase.com)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 2. PIKAMC S3 OBJECT STORAGE (Lấy tại trang quản lý S3 trên one.pikamc.vn)
# Endpoint kết nối S3 của PIKAMC (ví dụ: https://s3.pikamc.vn hoặc endpoint trong tab Cài đặt)
S3_ENDPOINT="https://s3.pikamc.vn"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-pikamc-access-key"
S3_SECRET_ACCESS_KEY="your-pikamc-secret-key"
S3_BUCKET_NAME="your-bucket-name"

# Domain công khai để người dùng xem/tải ảnh từ PIKAMC (VD: https://s3.pikamc.vn/your-bucket-name hoặc domain riêng)
NEXT_PUBLIC_S3_PUBLIC_DOMAIN="https://s3.pikamc.vn/your-bucket-name"
